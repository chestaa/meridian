# Meridian TSMOM Paper-Soak (Lyra B1 — BTC-only forward paper-soak, v3-btc-long)
#
# Runs Lyra's tsmom/tsmom-paper-soak.js — exact CLI mirrored from her in-file
# contract (lines 30-39). Each run: fetch latest BTC daily close (Yahoo) →
# compute v3-btc-long signal with data <= latest CLOSED bar (no peek) → mark the
# open paper position to market → on rebalance (>=21d) append ONE proxy period to
# the journal. IDEMPOTENT: re-running same UTC day only refreshes the MTM snapshot
# (date-guarded on the latest closed bar) — safe for a daily timer, no double-log.
#
# Verified one-shot on VPS 2026-06-25: action=cold_open, BTC closed bar 2026-06-24
# @ $60995, signal FLAT weight=0 (trailing-252d −44.94% → cash), state written to
# tsmom/data/soak-v3-btc-long.json. First JOURNAL row defers to the first rebalance
# (~21 days) — cold-open correctly logs no period. Journal-append path itself
# proven separately (backtest je_..._y1oh27).
#
# READ-ONLY re: money — NO money path, NO on-chain, NO real orders, NO LLM cost.
# Pure data fetch + state/journal append.
#
# Manual one-shot test:
#   systemctl start meridian-tsmom-soak.service
#   node /opt/meridian/tsmom/tsmom-paper-soak.js status   # inspect state, no write
#
# Reversible: `systemctl disable --now meridian-tsmom-soak.timer`.

[Unit]
Description=Meridian TSMOM Paper-Soak (Lyra B1 — BTC-only, PAPER/PROXY, no money path)
After=network-online.target
Wants=network-online.target
OnFailure=meridian-notify@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/meridian

# Low-priority: TSMOM is slow + non-urgent. Never compete with signal-runner.
Nice=10
IOSchedulingClass=idle

# Lyra's documented CLI: `run` = fetch latest, mark/rebalance, log to journal.
ExecStart=/usr/local/bin/node /opt/meridian/tsmom/tsmom-paper-soak.js run

Environment=NODE_ENV=production
# v3-btc-long is the pre-registered BTC-only hypothesis (NOT a curve-fit).
Environment=TSMOM_CONFIG_VERSION=v3-btc-long
EnvironmentFile=-/opt/meridian/.env
TimeoutStartSec=120s

# ── Read-only hardening: filesystem read-only except the dirs the runner writes.
#    journal.js resolves JOURNAL_FILE (else cwd/journal.jsonl). The default
#    journal.jsonl is at /opt/meridian (the SHARED ledger — keep it there so
#    `journal-cli report` sees TSMOM alongside everything). tsmom/data caches the
#    daily history the ingester refreshes. NOTE: with ProtectSystem=strict a
#    ReadWritePaths FILE must already exist at start; we therefore grant the
#    PARENT dirs (journal.jsonl pre-exists in practice, but dir-scope is robust
#    to first-run). Tighten to the exact files once Lyra's runner is wired.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/meridian /opt/meridian/tsmom/data

[Install]
WantedBy=multi-user.target
