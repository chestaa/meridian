[Unit]
Description=Meridian Solana DLMM agent
After=network-online.target
Wants=network-online.target
OnFailure=meridian-notify@%n.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meridian
Environment=NODE_ENV=production
Environment=DRY_RUN=true
ExecStart=/usr/local/bin/node /opt/meridian/index.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
EnvironmentFile=-/opt/meridian/.env

[Install]
WantedBy=multi-user.target
