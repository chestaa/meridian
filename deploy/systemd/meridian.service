[Unit]
Description=Meridian Solana DLMM agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meridian
WorkingDirectory=/opt/meridian
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
TimeoutStopSec=30

# Keep secrets in the project .env file
EnvironmentFile=-/opt/meridian/.env

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/meridian

[Install]
WantedBy=multi-user.target
