{
  "name": "dlmm-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous DLMM LP agent for Meteora on Solana",
  "main": "index.js",
  "bin": {
    "meridian": "cli.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "env:encrypt": "node scripts/envrypt.js encrypt",
    "start": "node index.js",
    "dev": "DRY_RUN=true node index.js",
    "test": "npm run test:syntax",
    "test:syntax": "node scripts/check-syntax.js",
    "test:signal": "node scripts/test-signal-parser.js",
    "benchmark:llm": "node scripts/benchmark-llm.js",
    "signal:runner": "node scripts/signal-runner.js",
    "signal:once": "node scripts/signal-runner.js --once",
    "test:screen": "node test/test-screening.js",
    "test:agent": "DRY_RUN=true node test/test-agent.js",
    "postinstall": "node scripts/patch-anchor.js"
  },
  "knip": {
    "ignore": [
      "discord-listener/**"
    ]
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1",
    "jsonrepair": "^3.13.3",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0",
    "telegram": "^2.26.22"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
