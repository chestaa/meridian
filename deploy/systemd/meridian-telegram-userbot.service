[Unit]
Description=Meridian Telegram Userbot (MTProto signal listener)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/meridian
ExecStart=/usr/local/bin/node /opt/meridian/telegram-userbot.js
Restart=on-failure
RestartSec=30s
Environment=NODE_ENV=production
EnvironmentFile=-/opt/meridian/.env

[Install]
WantedBy=multi-user.target
