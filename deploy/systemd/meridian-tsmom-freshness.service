# Meridian TSMOM Paper-Soak Freshness Guard (Draco/Ops — 18-day-stale lesson)
#
# Enable alongside the soak timer. NOTE: the soak logs its FIRST journal row only
# at the first rebalance (~21 days after cold-open), so this guard tracks
# TSMOM/v3-btc-long rows — until one exists it exits 0 (honest "no alert", not a
# false stall). It will start meaningfully guarding once forward periods accrue.
# To watch the soak STATE freshness sooner, point a future check at
# tsmom/data/soak-v3-btc-long.json last_run_at instead (the daily heartbeat).
#
# Reads the shared journal, FAILS (exit 1 → OnFailure Telegram alert) if the
# most-recent TSMOM/v3-btc-long entry is older than TSMOM_FRESH_MAX_DAYS (default 2).
# READ-ONLY: no money, no on-chain, no LLM, no writes.

[Unit]
Description=Meridian TSMOM paper-soak freshness guard (alert if no log in >2 days)
After=network-online.target
OnFailure=meridian-notify@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/meridian
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/local/bin/node /opt/meridian/scripts/tsmom-soak-freshness.js
Environment=NODE_ENV=production
Environment=TSMOM_FRESH_MAX_DAYS=2
EnvironmentFile=-/opt/meridian/.env
TimeoutStartSec=30s

# Pure read of the journal — no writes needed.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
